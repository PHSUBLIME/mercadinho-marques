            if (!lote || lote.qtd <= 0) return;

            const prod = appData.produtos.find(p => p.id == lote.produtoId);
            if (!prod) return;

            const itemExistente = appData.carrinhoPDV.find(i => i.loteId == lote.id);

            if (itemExistente) {
                if (itemExistente.qtd + 1 > lote.qtd) {
                    mostrarToast("Estoque do lote esgotado!", "alerta");
                    return;
                }
                itemExistente.qtd += 1;
                itemExistente.subtotal = itemExistente.qtd * itemExistente.precoVenda;
            } else {
                appData.carrinhoPDV.push({
                    loteId: lote.id,
                    produtoId: prod.id,
                    nome: prod.nome,
                    ean: prod.ean || '-',
                    qtd: 1,
                    precoVenda: parseFloat(prod.precoVenda || 0),
                    subtotal: parseFloat(prod.precoVenda || 0),
