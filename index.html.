<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mercearia Marques - Controle de Estoque & Validades</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #09090b; }
        @media print {
            .no-print { display: none !important; }
            body { background: #ffffff !important; color: #000000 !important; }
            .print-card { border: 1px solid #cccccc !important; }
            aside { display: none !important; }
            main { padding: 0 !important; }
        }
    </style>
</head>
<body class="bg-zinc-950 text-slate-100 min-h-screen flex flex-col md:flex-row">

    <!-- TELA DE LOGIN BLOQUEANTE -->
    <div id="tela-login" class="fixed inset-0 bg-black z-[999] flex items-center justify-center p-4">
        <div class="bg-zinc-900 border border-zinc-800 p-8 rounded-2xl max-w-md w-full space-y-6 shadow-2xl text-center">
            <div class="flex justify-center mb-2">
                <div class="w-20 h-20 bg-emerald-500/10 border border-emerald-500/30 rounded-2xl flex items-center justify-center text-emerald-400 text-4xl shadow-lg shadow-emerald-950/40">
                    <i class="fa-solid fa-store"></i>
                </div>
            </div>
            <div>
                <h2 class="text-2xl font-black text-emerald-400 tracking-wide">MERCEARIA MARQUES</h2>
                <p class="text-xs text-zinc-400 mt-1">Sistema de Gestão de Estoque & Controle de Validades</p>
            </div>

            <form onsubmit="fazerLogin(event)" class="space-y-4 text-left">
                <div>
                    <label class="block text-xs font-bold text-zinc-400 mb-1">Usuário</label>
                    <input type="text" id="login-usuario" required placeholder="admin" value="admin" class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-emerald-400">
                </div>
                <div>
                    <label class="block text-xs font-bold text-zinc-400 mb-1">Senha</label>
                    <input type="password" id="login-senha" required placeholder="••••••••" value="123456" class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-emerald-400">
                </div>

                <p id="login-erro" class="text-rose-500 text-xs text-center font-semibold hidden">Usuário ou senha incorretos!</p>

                <button type="submit" id="btn-entrar" class="w-full bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-black py-3 rounded-xl text-sm transition-all shadow-lg shadow-emerald-950/40">
                    ENTRAR NO SISTEMA
                </button>
            </form>
        </div>
    </div>

    <!-- BARRA LATERAL (SIDEBAR) -->
    <aside class="w-full md:w-64 bg-zinc-900 border-b md:border-b-0 md:border-r border-zinc-800 p-5 flex flex-col justify-between shrink-0 no-print">
        <div>
            <div class="flex items-center gap-3 px-2 py-3 mb-6 border-b border-zinc-800">
                <div class="w-10 h-10 bg-emerald-500/20 text-emerald-400 rounded-xl flex items-center justify-center text-xl shrink-0">
                    <i class="fa-solid fa-basket-shopping"></i>
                </div>
                <div>
                    <h1 class="text-base font-black tracking-wider text-emerald-400 leading-tight">MERCEARIA MARQUES</h1>
                    <span class="text-[10px] text-zinc-400 uppercase tracking-widest font-semibold block">Estoque & Validades</span>
                </div>
            </div>

            <!-- MENU DE NAVEGAÇÃO -->
            <nav class="space-y-1.5" id="nav-menu">
                <button onclick="navegar('dashboard')" id="btn-dashboard" class="nav-btn active flex items-center gap-3 w-full px-4 py-3 rounded-xl font-bold text-sm transition-all text-emerald-400 bg-emerald-500/10 border-l-4 border-emerald-400">
                    <i class="fa-solid fa-chart-pie text-base"></i> Dashboard
                </button>

                <button onclick="navegar('farol')" id="btn-farol" class="nav-btn flex items-center justify-between w-full px-4 py-3 rounded-xl font-semibold text-sm transition-all text-zinc-400 hover:text-white hover:bg-zinc-800">
                    <span class="flex items-center gap-3">
                        <i class="fa-solid fa-traffic-light text-base text-amber-400"></i> Farol de Validade
                    </span>
                    <span id="badge-farol-risco" class="bg-rose-500 text-white text-[10px] font-black px-2 py-0.5 rounded-full hidden">0</span>
                </button>

                <button onclick="navegar('estoque')" id="btn-estoque" class="nav-btn flex items-center gap-3 w-full px-4 py-3 rounded-xl font-semibold text-sm transition-all text-zinc-400 hover:text-white hover:bg-zinc-800">
                    <i class="fa-solid fa-boxes-stacked text-base text-emerald-400"></i> Estoque & Lotes
                </button>

                <button onclick="navegar('pdv')" id="btn-pdv" class="nav-btn flex items-center gap-3 w-full px-4 py-3 rounded-xl font-semibold text-sm transition-all text-zinc-400 hover:text-white hover:bg-zinc-800">
                    <i class="fa-solid fa-cash-register text-base text-emerald-400"></i> PDV / Vendas (FEFO)
                </button>

                <button onclick="navegar('liquidacao')" id="btn-liquidacao" class="nav-btn flex items-center gap-3 w-full px-4 py-3 rounded-xl font-semibold text-sm transition-all text-zinc-400 hover:text-white hover:bg-zinc-800">
                    <i class="fa-solid fa-tags text-base text-yellow-400"></i> Liquidação & Ofertas
                </button>

                <button onclick="navegar('perdas')" id="btn-perdas" class="nav-btn flex items-center gap-3 w-full px-4 py-3 rounded-xl font-semibold text-sm transition-all text-zinc-400 hover:text-white hover:bg-zinc-800">
                    <i class="fa-solid fa-dumpster text-base text-rose-400"></i> Perdas & Descartes
                </button>

                <button onclick="navegar('clientes')" id="btn-clientes" class="nav-btn flex items-center gap-3 w-full px-4 py-3 rounded-xl font-semibold text-sm transition-all text-zinc-400 hover:text-white hover:bg-zinc-800">
                    <i class="fa-solid fa-users text-base"></i> Clientes & Caderneta
                </button>

                <button onclick="fazerLogout()" class="nav-btn flex items-center gap-3 w-full px-4 py-3 rounded-xl font-semibold text-sm transition-all text-rose-500 hover:bg-rose-950/40 mt-6 border border-rose-900/40">
                    <i class="fa-solid fa-right-from-bracket text-base"></i> Sair
                </button>
            </nav>
        </div>

        <div class="mt-8 pt-4 border-t border-zinc-800 px-2 text-xs text-zinc-500">
            <p>© 2026 <strong class="text-emerald-400">Mercearia Marques</strong></p>
        </div>
    </aside>

    <!-- CONTEÚDO PRINCIPAL -->
    <main class="flex-1 p-4 md:p-8 overflow-y-auto space-y-6">

        <!-- ================= SEÇÃO: DASHBOARD ================= -->
        <section id="secao-dashboard" class="secao-conteudo space-y-6">
            <header class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-zinc-900 p-6 rounded-2xl border border-zinc-800 shadow-2xl">
                <div>
                    <div class="flex items-center gap-3">
                        <h2 class="text-3xl font-extrabold text-emerald-400 tracking-tight">Painel de Controle</h2>
                        <span class="bg-emerald-500/10 text-emerald-400 text-xs font-bold px-3.5 py-1.5 rounded-full border border-emerald-500/30 flex items-center gap-2">
                            <i class="fa-regular fa-calendar text-emerald-400"></i>
                            Hoje: <strong id="dataAtualExtenso" class="text-emerald-300">--/--/----</strong>
                        </span>
                    </div>
                    <p class="text-sm text-zinc-400 mt-1">Visão geral do estoque, produtos perto do vencimento e vendas da Mercearia Marques.</p>
                </div>

                <div class="flex flex-wrap gap-2.5 no-print">
                    <button onclick="abrirModalNovoLote()" class="flex items-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold px-4 py-2.5 rounded-xl text-sm transition-all shadow-lg shadow-emerald-950/30">
                        <i class="fa-solid fa-plus"></i> + Entrada de Lote/Validade
                    </button>
                </div>
            </header>

            <!-- CARDS DE MÉTRICAS -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-zinc-900 p-5 rounded-2xl border border-zinc-800 hover:border-emerald-500/50 transition-all">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs font-bold text-emerald-400 uppercase tracking-wider">Vendas Hoje</p>
                            <h3 class="text-2xl font-black text-white mt-1" id="dash-vendas-dia">R$ 0,00</h3>
                        </div>
                        <div class="p-3 bg-zinc-800 text-emerald-400 border border-zinc-700 rounded-xl">
                            <i class="fa-solid fa-cart-shopping text-xl"></i>
                        </div>
                    </div>
                    <p class="text-xs text-zinc-400 mt-3">Total faturado no PDV hoje</p>
                </div>

                <div class="bg-zinc-900 p-5 rounded-2xl border border-zinc-800 hover:border-rose-500/50 transition-all">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs font-bold text-rose-400 uppercase tracking-wider">Vencendo em 7 Dias</p>
                            <h3 class="text-2xl font-black text-rose-400 mt-1" id="dash-critico-count">0 Lotes</h3>
                        </div>
                        <div class="p-3 bg-rose-500/10 text-rose-400 border border-rose-500/30 rounded-xl">
                            <i class="fa-solid fa-triangle-exclamation text-xl"></i>
                        </div>
                    </div>
                    <p class="text-xs text-rose-300 font-medium mt-3">Risco crítico de perda</p>
                </div>

                <div class="bg-zinc-900 p-5 rounded-2xl border border-zinc-800 hover:border-amber-500/50 transition-all">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs font-bold text-amber-400 uppercase tracking-wider">Vencendo em 30 Dias</p>
                            <h3 class="text-2xl font-black text-amber-400 mt-1" id="dash-atencao-count">0 Lotes</h3>
                        </div>
                        <div class="p-3 bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded-xl">
                            <i class="fa-solid fa-clock text-xl"></i>
                        </div>
                    </div>
                    <p class="text-xs text-amber-300 font-medium mt-3">Ponto de atenção / Liquidação</p>
                </div>

                <div class="bg-zinc-900 p-5 rounded-2xl border border-zinc-800 hover:border-zinc-700 transition-all">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-xs font-bold text-zinc-400 uppercase tracking-wider">Prejuízo por Vencimento (Mês)</p>
                            <h3 class="text-2xl font-black text-white mt-1" id="dash-perdas-mes">R$ 0,00</h3>
                        </div>
                        <div class="p-3 bg-zinc-800 text-rose-400 border border-zinc-700 rounded-xl">
                            <i class="fa-solid fa-dumpster text-xl"></i>
                        </div>
                    </div>
                    <p class="text-xs text-zinc-400 mt-3">Total descartado no ciclo ativo</p>
                </div>
            </div>

            <!-- GRÁFICOS -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <div class="lg:col-span-2 bg-zinc-900 p-6 rounded-2xl border border-zinc-800">
                    <h3 class="text-lg font-extrabold text-emerald-400 uppercase tracking-wide mb-4">Saúde das Validades do Estoque</h3>
                    <div class="relative h-72">
                        <canvas id="validadeChart"></canvas>
                    </div>
                </div>

                <div class="bg-zinc-900 p-6 rounded-2xl border border-zinc-800">
                    <h3 class="text-lg font-extrabold text-emerald-400 uppercase tracking-wide mb-4">Vendas vs Perdas</h3>
                    <div class="relative h-72 flex items-center justify-center">
                        <canvas id="comparativoChart"></canvas>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= SEÇÃO: FAROL DE VALIDADE (FEFO) ================= -->
        <section id="secao-farol" class="secao-conteudo hidden space-y-6">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-zinc-900 p-6 rounded-2xl border border-zinc-800 shadow-2xl">
                <div>
                    <h2 class="text-2xl font-black text-amber-400 flex items-center gap-2">
                        <i class="fa-solid fa-traffic-light"></i> Farol de Validade & Gestão por Lotes
                    </h2>
                    <p class="text-zinc-400 text-sm mt-1">Monitore os produtos por ordem de vencimento (FEFO - Primeiro que vence é o primeiro que sai).</p>
                </div>

                <div class="flex items-center gap-2 bg-zinc-800 px-4 py-2 rounded-xl border border-zinc-700 text-xs">
                    <span class="font-bold text-zinc-400">Total de Lotes Monitorados:</span>
                    <span class="font-black text-emerald-400 text-base" id="farol-kpi-total-lotes">0</span>
                </div>
            </div>

            <!-- FILTROS DO FAROL -->
            <div class="bg-zinc-900 p-4 rounded-2xl border border-zinc-800 flex flex-col md:flex-row gap-4 items-center justify-between">
                <div class="flex flex-wrap items-center gap-2 w-full md:w-auto">
                    <button onclick="filtrarFarol('todos')" id="btn-farol-todos" class="px-4 py-2 rounded-xl text-xs font-bold bg-emerald-500 text-zinc-950">Todos</button>
                    <button onclick="filtrarFarol('critico')" id="btn-farol-critico" class="px-4 py-2 rounded-xl text-xs font-bold bg-zinc-800 text-rose-400 hover:bg-rose-950/40">🔴 Crítico (&le; 7 Dias)</button>
                    <button onclick="filtrarFarol('atencao')" id="btn-farol-atencao" class="px-4 py-2 rounded-xl text-xs font-bold bg-zinc-800 text-amber-400 hover:bg-amber-950/40">🟡 Atenção (&le; 30 Dias)</button>
                    <button onclick="filtrarFarol('ok')" id="btn-farol-ok" class="px-4 py-2 rounded-xl text-xs font-bold bg-zinc-800 text-emerald-400 hover:bg-emerald-950/40">🟢 OK (&gt; 30 Dias)</button>
                    <button onclick="filtrarFarol('vencido')" id="btn-farol-vencido" class="px-4 py-2 rounded-xl text-xs font-bold bg-zinc-800 text-purple-400 hover:bg-purple-950/40">⬛ Vencidos (Descarte)</button>
                </div>

                <div class="w-full md:w-80 bg-zinc-800 px-3 py-2 rounded-xl border border-zinc-700 flex items-center gap-2">
                    <i class="fa-solid fa-magnifying-glass text-emerald-400"></i>
                    <input type="text" id="input-pesquisar-farol" onkeyup="renderizarFarolValidade()" placeholder="Pesquisar lote, produto, código EAN..." class="bg-transparent text-white focus:outline-none text-xs w-full">
                </div>
            </div>

            <!-- TABELA DO FAROL -->
            <div class="bg-zinc-900 p-6 rounded-2xl border border-zinc-800 overflow-x-auto">
                <table class="w-full text-left text-sm text-zinc-300">
                    <thead class="text-xs uppercase bg-zinc-800 text-emerald-400 border-b border-zinc-700">
                        <tr>
                            <th class="p-3">Status Risco</th>
                            <th class="p-3">Produto / Cód. EAN</th>
                            <th class="p-3">Nº Lote</th>
                            <th class="p-3 text-center">Data Validade</th>
                            <th class="p-3 text-center">Dias Restantes</th>
                            <th class="p-3 text-center">Qtd Lote</th>
                            <th class="p-3">Localização</th>
                            <th class="p-3 text-right">Ações Rápidas</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-800" id="tabela-farol-body"></tbody>
                </table>
            </div>
        </section>

        <!-- ================= SEÇÃO: ESTOQUE E LOTES ================= -->
        <section id="secao-estoque" class="secao-conteudo hidden space-y-6">
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 bg-zinc-900 p-6 rounded-2xl border border-zinc-800 shadow-2xl">
                <div>
                    <h2 class="text-2xl font-black text-emerald-400 flex items-center gap-2">
                        <i class="fa-solid fa-boxes-stacked"></i> Cadastro de Produtos & Gestão de Lotes
                    </h2>
                    <p class="text-zinc-400 text-sm mt-1">Cadastre os produtos do mercado e controle os lotes de entrada com suas respectivas validades.</p>
                </div>

                <div class="flex flex-wrap gap-2.5">
                    <button onclick="abrirModalNovoProduto()" class="flex items-center gap-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 border border-zinc-700 px-4 py-2.5 rounded-xl text-sm font-bold transition-all">
                        <i class="fa-solid fa-plus text-emerald-400"></i> + Cadastrar Produto
                    </button>
                    <button onclick="abrirModalNovoLote()" class="flex items-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold px-4 py-2.5 rounded-xl text-sm transition-all shadow-lg shadow-emerald-950/30">
                        <i class="fa-solid fa-box-archive"></i> + Entrada de Lote
                    </button>
                </div>
            </div>

            <!-- CARDS DE MÉTRICAS -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-zinc-900 p-5 rounded-2xl border border-zinc-800">
                    <p class="text-xs font-bold text-emerald-400 uppercase">Produtos Cadastrados</p>
                    <h3 class="text-3xl font-black text-white mt-1" id="est-kpi-total-prods">0</h3>
                    <p class="text-xs text-zinc-500 mt-1">Itens no catálogo</p>
                </div>

                <div class="bg-zinc-900 p-5 rounded-2xl border border-zinc-800">
                    <p class="text-xs font-bold text-amber-400 uppercase">Total de Lotes Ativos</p>
                    <h3 class="text-3xl font-black text-amber-400 mt-1" id="est-kpi-total-lotes">0</h3>
                    <p class="text-xs text-zinc-500 mt-1">Fracionados por validade</p>
                </div>

                <div class="bg-zinc-900 p-5 rounded-2xl border border-zinc-800">
                    <p class="text-xs font-bold text-emerald-400 uppercase">Valor Total em Estoque</p>
                    <h3 class="text-3xl font-black text-emerald-400 mt-1" id="est-kpi-valor-total">R$ 0,00</h3>
                    <p class="text-xs text-zinc-500 mt-1">Preço de venda acumulado</p>
                </div>
            </div>

            <!-- BARRA DE PESQUISA -->
            <div class="bg-zinc-900 p-4 rounded-2xl border border-zinc-800 flex items-center gap-3">
                <i class="fa-solid fa-magnifying-glass text-emerald-400 text-lg ml-2"></i>
                <input type="text" id="input-pesquisar-estoque" onkeyup="renderizarEstoque()" placeholder="Pesquisar por nome do produto, código EAN, categoria..." class="w-full bg-transparent text-white focus:outline-none text-sm placeholder-zinc-500">
            </div>

            <!-- TABELA DE PRODUTOS -->
            <div class="bg-zinc-900 p-6 rounded-2xl border border-zinc-800 overflow-x-auto">
                <table class="w-full text-left text-sm text-zinc-300">
                    <thead class="text-xs uppercase bg-zinc-800 text-emerald-400 border-b border-zinc-700">
                        <tr>
                            <th class="p-3">Código EAN</th>
                            <th class="p-3">Produto / Marca</th>
                            <th class="p-3">Categoria</th>
                            <th class="p-3 text-center">Qtd Total</th>
                            <th class="p-3">Preço Custo</th>
                            <th class="p-3">Preço Venda</th>
                            <th class="p-3 text-center">Lotes Ativos</th>
                            <th class="p-3 text-right">Ações</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-800" id="tabela-estoque-body"></tbody>
                </table>
            </div>
        </section>

        <!-- ================= SEÇÃO: PDV / VENDAS (FEFO) ================= -->
        <section id="secao-pdv" class="secao-conteudo hidden space-y-6">
            <div class="bg-zinc-900 p-6 rounded-2xl border border-zinc-800 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h2 class="text-2xl font-black text-emerald-400 flex items-center gap-2">
                        <i class="fa-solid fa-cash-register"></i> Frente de Caixa / PDV Inteligente
                    </h2>
                    <p class="text-zinc-400 text-sm mt-1">Ao vender, o sistema dá baixa automática no lote com validade mais próxima (Metodologia FEFO).</p>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- LEITOR E BUSCA -->
                <div class="lg:col-span-2 space-y-4">
                    <div class="bg-zinc-900 p-5 rounded-2xl border border-zinc-800 space-y-3">
                        <label class="block text-xs font-bold uppercase tracking-wider text-emerald-400">
                            <i class="fa-solid fa-barcode"></i> Escanear Código EAN ou Digitar Nome do Produto
                        </label>
                        <div class="flex gap-2">
                            <input type="text" id="pdv-busca-input" list="dl-pdv-produtos" onkeypress="verificarEnterPDV(event)" placeholder="Bipe o código de barras ou digite o nome do produto..." class="w-full bg-zinc-800 border border-zinc-700 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-emerald-400 font-mono">
                            <datalist id="dl-pdv-produtos"></datalist>
                            <button onclick="adicionarItemPDVPorInput()" class="bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-black px-6 py-3 rounded-xl text-sm transition-all shrink-0">
                                Adicionar
                            </button>
                        </div>
                    </div>

                    <!-- CARRINHO DE ITENS -->
                    <div class="bg-zinc-900 p-6 rounded-2xl border border-zinc-800 space-y-4">
                        <h3 class="text-sm font-bold uppercase tracking-wider text-zinc-400 flex items-center gap-2">
                            <i class="fa-solid fa-basket-shopping text-emerald-400"></i> Itens da Venda Atual
                        </h3>
                        <div class="overflow-x-auto border border-zinc-800 rounded-xl">
                            <table class="w-full text-left text-xs text-zinc-300">
                                <thead class="uppercase bg-zinc-800 text-emerald-400 border-b border-zinc-700">
                                    <tr>
                                        <th class="p-3">Produto</th>
                                        <th class="p-3 text-center">Lote Usado (FEFO)</th>
                                        <th class="p-3 text-center">Qtd</th>
                                        <th class="p-3">Preço Un.</th>
                                        <th class="p-3">Subtotal</th>
                                        <th class="p-3 text-right">Ação</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-zinc-800" id="pdv-carrinho-body"></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- FINALIZAÇÃO DA VENDA -->
