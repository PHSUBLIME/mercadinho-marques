    <!-- SCRIPT PRINCIPAL DO MERCADINHO MARQUES -->
    <script>
        // ================= DADOS E ESTADO DO SISTEMA =================
        let usuarioAtual = "admin";

        let appData = {
            dataAtual: new Date().toISOString().split('T')[0],
            produtos: [],
            lotes: [],
            vendas: [],
            perdas: [],
            clientes: [],
            carrinhoPDV: [],
            filtroFarol: 'todos'
        };

        let validadeChart = null;
        let comparativoChart = null;

        // --- CARREGAR DADOS DO LOCALSTORAGE OU INICIALIZAR DEMO ---
        function carregarDados() {
            const salvas = localStorage.getItem('mercadinho_marques_data');
            if (salvas) {
                try {
                    appData = JSON.parse(salvas);
                    appData.carrinhoPDV = []; // Limpa carrinho ao reabrir
                } catch(e) {
                    console.error("Erro ao carregar do LocalStorage:", e);
                    carregarDadosDemo();
                }
            } else {
                carregarDadosDemo();
            }

            appData.dataAtual = new Date().toISOString().split('T')[0];
            atualizarInterfaceCompleta();
        }

        function salvarDados() {
            localStorage.setItem('mercadinho_marques_data', JSON.stringify({
                produtos: appData.produtos,
                lotes: appData.lotes,
                vendas: appData.vendas,
                perdas: appData.perdas,
                clientes: appData.clientes
            }));
            atualizarInterfaceCompleta();
        }

        function carregarDadosDemo() {
            const hoje = new Date();
            
            const addDias = (dias) => {
                const d = new Date(hoje);
                d.setDate(d.getDate() + dias);
                return d.toISOString().split('T')[0];
            };

            appData.produtos = [
                { id: 1, ean: '7891000100103', nome: 'Leite Integral Parmalat 1L', categoria: 'Laticínios', unidade: 'Un', precoCusto: 3.50, precoVenda: 5.49, estoqueMinimo: 10, localizacao: 'Gôndola A1' },
                { id: 2, ean: '7891000200202', nome: 'Iogurte Morango Nestlé 170g', categoria: 'Laticínios', unidade: 'Un', precoCusto: 1.80, precoVenda: 3.20, estoqueMinimo: 15, localizacao: 'Geladeira 1' },
                { id: 3, ean: '7891000300301', nome: 'Feijão Preto Camil 1Kg', categoria: 'Mercearia', unidade: 'Un', precoCusto: 4.20, precoVenda: 7.90, estoqueMinimo: 20, localizacao: 'Gôndola C2' },
                { id: 4, ean: '7891000400400', nome: 'Pão de Forma Wickbold 500g', categoria: 'Padaria', unidade: 'Un', precoCusto: 4.00, precoVenda: 8.50, estoqueMinimo: 8, localizacao: 'Gôndola B1' }
            ];

            appData.lotes = [
                { id: 101, produtoId: 1, numeroLote: 'LT-PARM-01', validade: addDias(4), qtd: 12, localizacao: 'Gôndola A1' },
                { id: 102, produtoId: 1, numeroLote: 'LT-PARM-02', validade: addDias(40), qtd: 30, localizacao: 'Depósito' },
                { id: 103, produtoId: 2, numeroLote: 'LT-NEST-01', validade: addDias(2), qtd: 8, localizacao: 'Geladeira 1' },
                { id: 104, produtoId: 3, numeroLote: 'LT-CAM-01', validade: addDias(90), qtd: 50, localizacao: 'Gôndola C2' },
                { id: 105, produtoId: 4, numeroLote: 'LT-WICK-01', validade: addDias(12), qtd: 10, localizacao: 'Gôndola B1' }
            ];

            appData.clientes = [
                { id: 1, nome: 'Dona Maria da Silva', telefone: '(21) 98888-1111', endereco: 'Rua Principal, 102', limiteFiado: 300, debito: 45.00 },
                { id: 2, nome: 'Seu José dos Santos', telefone: '(21) 97777-2222', endereco: 'Rua das Flores, 45', limiteFiado: 200, debito: 0.00 }
            ];

            appData.vendas = [];
            appData.perdas = [];
            salvarDados();
        }

        // ================= AUTENTICAÇÃO E NAVEGAÇÃO =================
        function fazerLogin(e) {
            e.preventDefault();
            const u = document.getElementById('login-usuario').value.trim();
            const s = document.getElementById('login-senha').value;

            if (u && s) {
                usuarioAtual = u;
                document.getElementById('tela-login').classList.add('hidden');
                carregarDados();
                mostrarToast(`Bem-vindo ao Mercadinho Marques, ${usuarioAtual}!`);
            } else {
                document.getElementById('login-erro').classList.remove('hidden');
            }
        }

        function fazerLogout() {
            document.getElementById('tela-login').classList.remove('hidden');
        }

        function navegar(secao) {
            document.querySelectorAll('.secao-conteudo').forEach(el => el.classList.add('hidden'));
            const alvo = document.getElementById(`secao-${secao}`);
            if (alvo) alvo.classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('active', 'text-emerald-400', 'bg-emerald-500/10', 'border-l-4', 'border-emerald-400', 'font-bold');
                btn.classList.add('text-zinc-400', 'hover:text-white', 'hover:bg-zinc-800', 'font-semibold');
            });

            const btnAtivo = document.getElementById(`btn-${secao}`);
            if (btnAtivo) {
                btnAtivo.classList.remove('text-zinc-400', 'hover:text-white', 'hover:bg-zinc-800', 'font-semibold');
                btnAtivo.classList.add('active', 'text-emerald-400', 'bg-emerald-500/10', 'border-l-4', 'border-emerald-400', 'font-bold');
            }

            if (secao === 'dashboard') atualizarGraficos();
        }

        // ================= ATUALIZAÇÃO GERAL DA INTERFACE =================
        function atualizarInterfaceCompleta() {
            const hojeStr = appData.dataAtual;
            
            const pData = appData.dataAtual.split('-');
            if (pData.length === 3) {
                document.getElementById('dataAtualExtenso').innerText = `${pData[2]}/${pData[1]}/${pData[0]}`;
            }

            // Cálculo Vendas Hoje
            let vendasHoje = 0;
            appData.vendas.forEach(v => {
                if (v.data === hojeStr) vendasHoje += parseFloat(v.total || 0);
            });

            // Cálculo Perdas Mês
            let perdasMes = 0;
            appData.perdas.forEach(p => {
                perdasMes += parseFloat(p.prejuizio || 0);
            });

            // Contagem Farol de Validade
            let countCritico = 0;
            let countAtencao = 0;

            const hojeDate = new Date(hojeStr);

            appData.lotes.forEach(l => {
                if (l.qtd <= 0) return;
                const valDate = new Date(l.validade);
                const diffDias = Math.ceil((valDate - hojeDate) / (1000 * 60 * 60 * 24));

                if (diffDias <= 7) countCritico++;
                else if (diffDias <= 30) countAtencao++;
            });

            // Badges & KPIs
            document.getElementById('dash-vendas-dia').innerText = `R$ ${vendasHoje.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
            document.getElementById('dash-critico-count').innerText = `${countCritico} Lotes`;
            document.getElementById('dash-atencao-count').innerText = `${countAtencao} Lotes`;
            document.getElementById('dash-perdas-mes').innerText = `R$ ${perdasMes.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;

            const badgeFarol = document.getElementById('badge-farol-risco');
            if (badgeFarol) {
                if (countCritico > 0) {
                    badgeFarol.innerText = countCritico;
                    badgeFarol.classList.remove('hidden');
                } else {
                    badgeFarol.classList.add('hidden');
                }
            }

            renderizarFarolValidade();
            renderizarEstoque();
            popularDatalistPDV();
            renderizarLiquidacao();
            renderizarPerdas();
            renderizarClientes();
            atualizarGraficos();
        }

        // ================= FAROL DE VALIDADE (FEFO) =================
        function renderizarFarolValidade() {
            const tbody = document.getElementById('tabela-farol-body');
            if (!tbody) return;
            tbody.innerHTML = '';

            const busca = (document.getElementById('input-pesquisar-farol')?.value || '').toLowerCase();
            const hojeDate = new Date(appData.dataAtual);

            let lotesAtivos = appData.lotes.filter(l => l.qtd > 0);
            
            // Ordenação FEFO (Quem vence primeiro fica no topo)
            lotesAtivos.sort((a, b) => new Date(a.validade) - new Date(b.validade));

            document.getElementById('farol-kpi-total-lotes').innerText = lotesAtivos.length;

            if (lotesAtivos.length === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="p-6 text-center text-zinc-500 text-xs">Nenhum lote cadastrado. Clique em <strong>"+ Entrada de Lote"</strong> para adicionar!</td></tr>`;
                return;
            }

            lotesAtivos.forEach(lote => {
                const prod = appData.produtos.find(p => p.id == lote.produtoId);
                const nomeProd = prod ? prod.nome : 'Produto Não Encontrado';
                const eanProd = prod ? (prod.ean || '-') : '-';

                const valDate = new Date(lote.validade);
                const diffDias = Math.ceil((valDate - hojeDate) / (1000 * 60 * 60 * 24));

                let statusChave = 'ok';
                let statusBadge = '<span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase"><i class="fa-solid fa-check"></i> 🟢 OK</span>';

                if (diffDias <= 0) {
                    statusChave = 'vencido';
                    statusBadge = '<span class="bg-purple-950 text-purple-300 border border-purple-500/40 px-2.5 py-1 rounded-full text-[10px] font-black uppercase"><i class="fa-solid fa-skull"></i> ⬛ VENCIDO</span>';
                } else if (diffDias <= 7) {
                    statusChave = 'critico';
                    statusBadge = '<span class="bg-rose-500/20 text-rose-400 border border-rose-500/40 px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider animate-pulse"><i class="fa-solid fa-triangle-exclamation"></i> 🔴 CRÍTICO</span>';
                } else if (diffDias <= 30) {
                    statusChave = 'atencao';
                    statusBadge = '<span class="bg-amber-500/20 text-amber-400 border border-amber-500/40 px-2.5 py-1 rounded-full text-[10px] font-bold uppercase"><i class="fa-solid fa-clock"></i> 🟡 ATENÇÃO</span>';
                }

                if (appData.filtroFarol !== 'todos' && statusChave !== appData.filtroFarol) return;

                const buscaTexto = `${nomeProd} ${eanProd} ${lote.numeroLote} ${lote.localizacao}`.toLowerCase();
                if (busca && !buscaTexto.includes(busca)) return;

                const pVal = lote.validade.split('-');
                const valFormatada = pVal.length === 3 ? `${pVal[2]}/${pVal[1]}/${pVal[0]}` : lote.validade;

                const tr = document.createElement('tr');
                tr.className = statusChave === 'critico' ? "bg-rose-950/20 hover:bg-rose-950/40 transition-all" : "hover:bg-zinc-800/40 transition-all";
                tr.innerHTML = `
                    <td class="p-3">${statusBadge}</td>
                    <td class="p-3">
                        <strong class="text-white text-sm block">${escapeAttr(nomeProd)}</strong>
                        <span class="text-[10px] font-mono text-zinc-500"><i class="fa-solid fa-barcode"></i> ${escapeAttr(eanProd)}</span>
                    </td>
                    <td class="p-3 font-mono text-xs text-zinc-300">${escapeAttr(lote.numeroLote || 'N/A')}</td>
                    <td class="p-3 text-center font-bold text-white text-xs">${valFormatada}</td>
                    <td class="p-3 text-center font-black ${diffDias <= 7 ? 'text-rose-400' : (diffDias <= 30 ? 'text-amber-400' : 'text-emerald-400')}">
                        ${diffDias <= 0 ? 'Expirado' : `${diffDias} dias`}
                    </td>
                    <td class="p-3 text-center font-bold text-white">${lote.qtd} <span class="text-[10px] text-zinc-500">${prod ? prod.unidade : 'Un'}</span></td>
                    <td class="p-3 text-xs text-zinc-400">${escapeAttr(lote.localizacao || 'Balcão')}</td>
                    <td class="p-3 text-right space-x-1">
                        <button onclick="adicionarLoteAoPDVRapido(${lote.id})" class="bg-emerald-500/20 hover:bg-emerald-500 text-emerald-400 hover:text-zinc-950 p-2 rounded-lg text-xs font-bold transition-all" title="Vender Lote no PDV">
                            <i class="fa-solid fa-cart-plus"></i> Vender
                        </button>
                        <button onclick="abrirModalBaixaPerdaComLote(${lote.id})" class="bg-rose-950/50 hover:bg-rose-900 text-rose-400 p-2 rounded-lg text-xs" title="Descartar por Perda">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function filtrarFarol(tipo) {
            appData.filtroFarol = tipo;
            document.querySelectorAll('#secao-farol button[id^="btn-farol-"]').forEach(b => {
                b.className = "px-4 py-2 rounded-xl text-xs font-bold bg-zinc-800 text-zinc-300 hover:bg-zinc-700";
            });
            const btnAtivo = document.getElementById(`btn-farol-${tipo}`);
            if (btnAtivo) btnAtivo.className = "px-4 py-2 rounded-xl text-xs font-bold bg-emerald-500 text-zinc-950";
            renderizarFarolValidade();
        }

        // ================= ESTOQUE E PRODUTOS =================
        function renderizarEstoque() {
            const tbody = document.getElementById('tabela-estoque-body');
            if (!tbody) return;
            tbody.innerHTML = '';

            const busca = (document.getElementById('input-pesquisar-estoque')?.value || '').toLowerCase();
            let totalProds = appData.produtos.length;
            let totalLotesCount = appData.lotes.filter(l => l.qtd > 0).length;
            let valorTotalGeral = 0;

            document.getElementById('est-kpi-total-prods').innerText = totalProds;
            document.getElementById('est-kpi-total-lotes').innerText = totalLotesCount;

            if (totalProds === 0) {
                tbody.innerHTML = `<tr><td colspan="8" class="p-6 text-center text-zinc-500 text-xs">Nenhum produto cadastrado no catálogo.</td></tr>`;
                return;
            }

            appData.produtos.forEach(p => {
                const lotesProd = appData.lotes.filter(l => l.produtoId == p.id && l.qtd > 0);
                const qtdTotalProd = lotesProd.reduce((acc, l) => acc + parseFloat(l.qtd || 0), 0);
                const valorProd = qtdTotalProd * parseFloat(p.precoVenda || 0);
                valorTotalGeral += valorProd;

                const buscaTexto = `${p.nome} ${p.ean} ${p.categoria}`.toLowerCase();
                if (busca && !buscaTexto.includes(busca)) return;

                const tr = document.createElement('tr');
                tr.className = "hover:bg-zinc-800/40 transition-all";
                tr.innerHTML = `
                    <td class="p-3 font-mono text-xs text-emerald-400"><i class="fa-solid fa-barcode"></i> ${escapeAttr(p.ean || 'N/A')}</td>
                    <td class="p-3 font-bold text-white">${escapeAttr(p.nome)}</td>
                    <td class="p-3 text-xs text-zinc-400">${escapeAttr(p.categoria)}</td>
                    <td class="p-3 text-center font-black text-white">${qtdTotalProd} <span class="text-[10px] font-normal text-zinc-500">${escapeAttr(p.unidade)}</span></td>
                    <td class="p-3 text-xs text-rose-300">R$ ${parseFloat(p.precoCusto||0).toFixed(2)}</td>
                    <td class="p-3 font-bold text-emerald-400">R$ ${parseFloat(p.precoVenda||0).toFixed(2)}</td>
                    <td class="p-3 text-center"><span class="px-2 py-1 bg-zinc-800 rounded-lg text-xs font-bold text-amber-400">${lotesProd.length} Lote(s)</span></td>
                    <td class="p-3 text-right space-x-1">
                        <button onclick="editarProduto(${p.id})" class="bg-zinc-800 hover:bg-zinc-700 text-emerald-400 p-2 rounded-lg text-xs" title="Editar Produto">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button onclick="excluirProduto(${p.id})" class="bg-rose-950/50 hover:bg-rose-900 text-rose-400 p-2 rounded-lg text-xs" title="Excluir Produto">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('est-kpi-valor-total').innerText = `R$ ${valorTotalGeral.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
        }

        function abrirModalNovoProduto() {
            document.getElementById('modal-produto-titulo').innerHTML = `<i class="fa-solid fa-basket-shopping"></i> Cadastrar Produto no Catálogo`;
            document.getElementById('form-produto').reset();
            document.getElementById('prod-id').value = '';
            document.getElementById('modal-novo-produto').classList.remove('hidden');
        }

        function fecharModalNovoProduto() { document.getElementById('modal-novo-produto').classList.add('hidden'); }

        function editarProduto(id) {
            const p = appData.produtos.find(x => x.id == id);
            if (!p) return;

            document.getElementById('modal-produto-titulo').innerHTML = `<i class="fa-solid fa-pen"></i> Editar Produto`;
            document.getElementById('prod-id').value = p.id;
            document.getElementById('prod-ean').value = p.ean || '';
            document.getElementById('prod-nome').value = p.nome || '';
            document.getElementById('prod-categoria').value = p.categoria || 'Laticínios';
            document.getElementById('prod-unidade').value = p.unidade || 'Un';
            document.getElementById('prod-preco-custo').value = p.precoCusto || 0;
            document.getElementById('prod-preco-venda').value = p.precoVenda || 0;
            document.getElementById('prod-estoque-minimo').value = p.estoqueMinimo || 5;
            document.getElementById('prod-localizacao').value = p.localizacao || '';

            document.getElementById('modal-novo-produto').classList.remove('hidden');
        }

        function salvarProdutoCat(e) {
            e.preventDefault();
            const idInput = document.getElementById('prod-id').value;
            const nome = document.getElementById('prod-nome').value.trim();

            if (!nome) return;

            const pData = {
                id: idInput ? parseInt(idInput) : Date.now(),
                ean: document.getElementById('prod-ean').value.trim(),
                nome: nome,
                categoria: document.getElementById('prod-categoria').value,
                unidade: document.getElementById('prod-unidade').value,
                precoCusto: parseFloat(document.getElementById('prod-preco-custo').value || 0),
                precoVenda: parseFloat(document.getElementById('prod-preco-venda').value || 0),
                estoqueMinimo: parseInt(document.getElementById('prod-estoque-minimo').value || 5),
                localizacao: document.getElementById('prod-localizacao').value.trim()
            };

            if (idInput) {
                const idx = appData.produtos.findIndex(x => x.id == idInput);
                if (idx !== -1) appData.produtos[idx] = pData;
            } else {
                appData.produtos.push(pData);
            }

            salvarDados();
            fecharModalNovoProduto();
            mostrarToast("Produto salvo no catálogo!");
        }

        async function excluirProduto(id) {
            const confirmou = await confirmarAcao("Excluir Produto", "Deseja realmente excluir este produto e seus lotes?", "Sim, Excluir");
            if (confirmou) {
                appData.produtos = appData.produtos.filter(p => p.id != id);
                appData.lotes = appData.lotes.filter(l => l.produtoId != id);
                salvarDados();
                mostrarToast("Produto removido.");
            }
        }

        // --- ENTRADA DE LOTES E VALIDADE ---
        function abrirModalNovoLote() {
            document.getElementById('form-lote').reset();
            document.getElementById('lote-id').value = '';
            document.getElementById('lote-produto-input').value = '';
            document.getElementById('lote-produto-id').value = '';
            popularDatalistLoteProdutos();
            document.getElementById('modal-novo-lote').classList.remove('hidden');
        }

        function fecharModalNovoLote() { document.getElementById('modal-novo-lote').classList.add('hidden'); }

        function popularDatalistLoteProdutos() {
            const dl = document.getElementById('dl-lote-produtos');
            if (!dl) return;
            dl.innerHTML = '';
            appData.produtos.forEach(p => {
                const opt = document.createElement('option');
                opt.value = `${p.nome} ${p.ean ? `[EAN:${p.ean}]` : ''} [ID:${p.id}]`;
                dl.appendChild(opt);
            });
        }

        function selecionarProdutoParaLote(val) {
            if (!val) return;
            const matchId = val.match(/\[ID:(\d+)\]/);
            if (matchId && matchId[1]) {
                document.getElementById('lote-produto-id').value = matchId[1];
            } else {
                const prod = appData.produtos.find(p => p.nome.toLowerCase() === val.toLowerCase() || p.ean === val);
                if (prod) document.getElementById('lote-produto-id').value = prod.id;
            }
        }

        function salvarEntradaLote(e) {
            e.preventDefault();
            let prodId = document.getElementById('lote-produto-id').value;
            const prodInputVal = document.getElementById('lote-produto-input').value;

            if (!prodId && prodInputVal) {
                selecionarProdutoParaLote(prodInputVal);
                prodId = document.getElementById('lote-produto-id').value;
            }

            if (!prodId) {
                mostrarToast("Selecione um produto do catálogo antes de criar o lote!", "erro");
                return;
            }

            const loteData = {
                id: Date.now(),
                produtoId: parseInt(prodId),
                numeroLote: document.getElementById('lote-numero').value.trim() || `LT-${Math.floor(100+Math.random()*900)}`,
                validade: document.getElementById('lote-validade').value,
                qtd: parseFloat(document.getElementById('lote-qtd').value || 1),
                localizacao: document.getElementById('lote-localizacao').value.trim() || 'Gôndola'
            };

            appData.lotes.push(loteData);
            salvarDados();
            fecharModalNovoLote();
            mostrarToast("Novo lote com validade registrado com sucesso!");
        }

        // ================= PDV / FRENTE DE CAIXA INTELIGENTE (FEFO) =================
        function popularDatalistPDV() {
            const dl = document.getElementById('dl-pdv-produtos');
            if (!dl) return;
            dl.innerHTML = '';
            appData.produtos.forEach(p => {
                const opt = document.createElement('option');
                opt.value = `${p.nome} ${p.ean ? `(${p.ean})` : ''}`;
                dl.appendChild(opt);
            });

            // Popular select de clientes para Caderneta
            const selCli = document.getElementById('pdv-cliente-select');
            if (selCli) {
                selCli.innerHTML = `<option value="">Venda Balcão (Cliente Não Identificado)</option>`;
                appData.clientes.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.id;
                    opt.innerText = `${c.nome} (Débito: R$ ${parseFloat(c.debito||0).toFixed(2)})`;
                    selCli.appendChild(opt);
                });
            }
        }

        function verificarEnterPDV(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                adicionarItemPDVPorInput();
            }
        }

        function adicionarItemPDVPorInput() {
            const input = document.getElementById('pdv-busca-input');
            const termo = input.value.trim().toLowerCase();
            if (!termo) return;

            // Busca por EAN exato ou por Nome
            const prod = appData.produtos.find(p => (p.ean && p.ean.toLowerCase() === termo) || p.nome.toLowerCase().includes(termo));

            if (!prod) {
                mostrarToast("Produto não encontrado no catálogo!", "erro");
                return;
            }

            // APLICAR REGRA FEFO: Busca os lotes ativos desse produto ordenados da menor validade para a maior
            const lotesDisponiveis = appData.lotes
                .filter(l => l.produtoId == prod.id && l.qtd > 0)
                .sort((a, b) => new Date(a.validade) - new Date(b.validade));

            if (lotesDisponiveis.length === 0) {
                mostrarToast(`Produto "${prod.nome}" sem estoque nos lotes!`, "erro");
                return;
            }

            const loteMaisAntigo = lotesDisponiveis[0];

            // Verifica se já está no carrinho
            const itemExistente = appData.carrinhoPDV.find(i => i.loteId == loteMaisAntigo.id);

            if (itemExistente) {
                if (itemExistente.qtd + 1 > loteMaisAntigo.qtd) {
                    mostrarToast(`Quantidade máxima do lote (${loteMaisAntigo.qtd}) atingida!`, "alerta");
                    return;
                }
                itemExistente.qtd += 1;
                itemExistente.subtotal = itemExistente.qtd * itemExistente.precoVenda;
            } else {
                appData.carrinhoPDV.push({
                    loteId: loteMaisAntigo.id,
                    produtoId: prod.id,
                    nome: prod.nome,
                    ean: prod.ean || '-',
                    qtd: 1,
                    precoVenda: parseFloat(prod.precoVenda || 0),
                    subtotal: parseFloat(prod.precoVenda || 0),
                    validade: loteMaisAntigo.validade
                });
            }

            input.value = '';
            renderizarCarrinhoPDV();
            mostrarToast(`"${prod.nome}" adicionado (Lote FEFO: ${loteMaisAntigo.validade})`);
        }

        function adicionarLoteAoPDVRapido(loteId) {
