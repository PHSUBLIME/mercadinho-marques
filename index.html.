        // ================= UTILITÁRIOS & TOASTS =================
        function confirmarAcao(titulo, mensagem, textoBotao = "Confirmar", icone = "fa-trash-can", cor = "rose") {
            return new Promise((resolve) => {
                const modal = document.getElementById('modal-confirmacao');
                const box = document.getElementById('modal-confirmacao-box');
                document.getElementById('modal-confirmacao-titulo').innerText = titulo;
                document.getElementById('modal-confirmacao-mensagem').innerText = mensagem;
                const btnOk = document.getElementById('btn-confirmar-ok');
                btnOk.innerText = textoBotao;

                modal.classList.remove('hidden');
                setTimeout(() => {
                    box.classList.remove('scale-95', 'opacity-0');
                    box.classList.add('scale-100', 'opacity-100');
                }, 10);

                const fechar = (resp) => {
                    box.classList.remove('scale-100', 'opacity-100');
                    box.classList.add('scale-95', 'opacity-0');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                        resolve(resp);
                    }, 150);
                };

                btnOk.onclick = () => fechar(true);
                document.getElementById('btn-confirmar-cancelar').onclick = () => fechar(false);
            });
        }

        function mostrarToast(msg, tipo = 'sucesso') {
            const toast = document.getElementById('toast');
            const icon = document.getElementById('toast-icon');
            document.getElementById('toast-message').innerText = msg;

            if (tipo === 'erro' || tipo === 'alerta') {
                toast.className = "fixed bottom-5 right-5 bg-zinc-900 text-white border border-rose-500 px-5 py-3 rounded-xl shadow-2xl transform translate-y-20 opacity-0 transition-all duration-300 flex items-center gap-3 z-[1001]";
                icon.className = "fa-solid fa-triangle-exclamation text-rose-500 text-lg";
            } else {
                toast.className = "fixed bottom-5 right-5 bg-zinc-900 text-white border border-emerald-400 px-5 py-3 rounded-xl shadow-2xl transform translate-y-20 opacity-0 transition-all duration-300 flex items-center gap-3 z-[1001]";
                icon.className = "fa-solid fa-circle-check text-emerald-400 text-lg";
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => toast.classList.add('translate-y-20', 'opacity-0'), 3500);
        }

        function escapeAttr(str) {
            if (str === null || str === undefined) return '';
            return String(str).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/'/g, '&#39;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        window.onload = carregarDados;
    </script>
</body>
</html>
