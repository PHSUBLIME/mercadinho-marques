        function renderizarCarrinhoPDV() {
            const tbody = document.getElementById('pdv-carrinho-body');
            tbody.innerHTML = '';
            let totalVenda = 0;

            if (appData.carrinhoPDV.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-zinc-500 text-xs italic">Nenhum item no carrinho. Bipe um código de barras acima!</td></tr>`;
                document.getElementById('pdv-total-txt').innerText = `R$ 0,00`;
                return;
            }

            appData.carrinhoPDV.forEach((item, index) => {
                totalVenda += item.subtotal;
                const pVal = item.validade.split('-');
                const valFormatada = pVal.length === 3 ? `${pVal[2]}/${pVal[1]}` : item.validade;

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="p-3 font-bold text-white">${escapeAttr(item.nome)}</td>
                    <td class="p-3 text-center"><span class="px-2 py-0.5 bg-amber-500/10 text-amber-400 font-bold rounded text-[11px]">Vence: ${valFormatada}</span></td>
                    <td class="p-3 text-center">
                        <input type="number" min="1" value="${item.qtd}" onchange="alterarQtdPDV(${index}, this.value)" class="w-14 bg-zinc-800 border border-zinc-700 rounded text-center text-white font-bold p-1">
                    </td>
                    <td class="p-3 font-semibold text-zinc-300">R$ ${item.precoVenda.toFixed(2)}</td>
                    <td class="p-3 font-black text-emerald-400">R$ ${item.subtotal.toFixed(2)}</td>
                    <td class="p-3 text-right">
                        <button onclick="removerItemPDV(${index})" class="text-rose-400 hover:text-rose-300 p-1"><i class="fa-solid fa-trash"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('pdv-total-txt').innerText = `R$ ${totalVenda.toLocaleString('pt-BR', {minimumFractionDigits: 2})}`;
        }

        function alterarQtdPDV(index, novaQtd) {
            const qtd = parseInt(novaQtd) || 1;
            const item = appData.carrinhoPDV[index];
            const lote = appData.lotes.find(l => l.id == item.loteId);

            if (lote && qtd > lote.qtd) {
                mostrarToast(`Apenas ${lote.qtd} unidades disponíveis neste lote!`, "alerta");
                item.qtd = lote.qtd;
            } else {
                item.qtd = qtd;
            }
            item.subtotal = item.qtd * item.precoVenda;
            renderizarCarrinhoPDV();
        }

        function removerItemPDV(index) {
            appData.carrinhoPDV.splice(index, 1);
            renderizarCarrinhoPDV();
        }

        function limparCarrinhoPDV() {
            appData.carrinhoPDV = [];
            renderizarCarrinhoPDV();
        }

        function finalizarVendaPDV() {
            if (appData.carrinhoPDV.length === 0) {
                mostrarToast("Adicione itens ao carrinho antes de finalizar!", "erro");
                return;
            }

            const formaPag = document.getElementById('pdv-forma-pagamento').value;
            const clienteId = document.getElementById('pdv-cliente-select').value;
            const totalVenda = appData.carrinhoPDV.reduce((acc, i) => acc + i.subtotal, 0);

            // Se for Caderneta/Fiado, exige cliente selecionado
            if (formaPag === 'Caderneta/Fiado' && !clienteId) {
                mostrarToast("Para vender Fiado/Caderneta, selecione um cliente!", "erro");
                return;
            }

            // 1. DÁ BAIXA AUTOMÁTICA NOS LOTES UTILIZADOS
            appData.carrinhoPDV.forEach(item => {
                const lote = appData.lotes.find(l => l.id == item.loteId);
                if (lote) {
                    lote.qtd = Math.max(0, lote.qtd - item.qtd);
                }
            });

            // 2. REGISTRA A VENDA
            const novaVenda = {
                id: Date.now(),
                data: appData.dataAtual,
                itens: [...appData.carrinhoPDV],
                total: totalVenda,
                formaPagamento: formaPag,
                clienteId: clienteId || null,
                vendedor: usuarioAtual
            };

            appData.vendas.push(novaVenda);

            // 3. SE FOR FIADO, ADICIONA DÉBITO AO CLIENTE
            if (formaPag === 'Caderneta/Fiado' && clienteId) {
                const cli = appData.clientes.find(c => c.id == clienteId);
                if (cli) {
                    cli.debito = (parseFloat(cli.debito || 0) + totalVenda);
                }
            }

            salvarDados();
            limparCarrinhoPDV();
            mostrarToast(`Venda de R$ ${totalVenda.toFixed(2)} finalizada com sucesso! 🛒`);
        }

